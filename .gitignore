# --- results -------------------------------------------------------------
# raw and intermediate are regenerable from config/ + code; final is the paper
results/raw/*
results/intermediate/*
!results/raw/.gitkeep
!results/intermediate/.gitkeep

# --- scratch -------------------------------------------------------------
# throwaway plots: look at them, never commit them
tmp/
sandbox/plots/
sandbox/**/*.png
sandbox/**/*.svg
sandbox/**/.ipynb_checkpoints/
sandbox/**/__pycache__/
sandbox/**/*.pkl
sandbox/**/*.npy

# --- private research workspace ------------------------------------------
# Internal theorem ledgers, proof campaigns, prompts, and working notes.
notes/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- R -------------------------------------------------------------------
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/
renv/staging/

# --- os ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
